# LLM calls use a locally logged-in CLI (your Google / Claude / ChatGPT account), no API key.
# LLM_PROVIDER: antigravity | claude | codex
LLM_PROVIDER=antigravity
# LLM_MODEL: empty = gemini-3.8-flash-medium for antigravity (list: agy models),
# the CLI's own default for claude / codex, or e.g. sonnet / opus for claude
LLM_MODEL=
LLM_TIMEOUT_SECONDS=300
# Only needed if the backend can't find the CLI on PATH:
# ANTIGRAVITY_BIN=/full/path/to/agy
# CLAUDE_BIN=/full/path/to/claude
# CODEX_BIN=/full/path/to/codex

# Access from your phone over Tailscale (see backend/README.md). Pick a long random value;
# the phone asks for it once. Leave empty to allow access only from this computer.
API_TOKEN=

# Job search
SEARCH_MAX_AGE_DAYS=30
# Max postings sent to the LLM for scoring per run (keeps CLI usage in check)
SEARCH_MAX_SCORED_PER_RUN=40
# Postings scored below this are dropped instead of listed
SEARCH_MIN_SCORE_TO_KEEP=50
# Web search (enable "Web araması" in the settings): time limit and max postings per run.
# With antigravity, allow page reading once in ~/.gemini/antigravity-cli/settings.json:
#   {"permissions": {"allow": ["read_url(*)", "search_web(*)"]}}
WEB_SEARCH_TIMEOUT_SECONDS=900
WEB_SEARCH_MAX_RESULTS=15
# Model for web search only (empty = LLM_MODEL); a faster one keeps the many turns short
WEB_SEARCH_MODEL=
SCHEDULER_ENABLED=true

# Job alert emails (optional, enable "email_alerts" in the settings).
# Gmail: turn on 2-step verification, create an app password at
# https://myaccount.google.com/apppasswords and paste it below (not your normal password).
IMAP_HOST=imap.gmail.com
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
# Postings from the alert emails of this many days are filtered again on every run, so a
# role added later still finds them. Each email is read by the LLM only once.
EMAIL_LOOKBACK_DAYS=14

# Daily report email (enable "Sabah raporu" in the settings). The login defaults to the
# IMAP account above and the report goes to that address; override if needed.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# SMTP_USER=
# SMTP_PASSWORD=
# REPORT_EMAIL_TO=
# Link the report to the app, e.g. your Tailscale address
# APP_URL=https://bilgisayar.tail1234.ts.net
# The app only answers these hosts (plus the APP_URL host); add yours if you use another address.
# ALLOWED_HOSTS=["localhost", "127.0.0.1", "*.ts.net"]
LLM_MAX_CONCURRENCY=2

# Adzuna (optional): https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=gb
