<!doctype html>
<html lang="{{ lang }}">
<head>
<meta charset="utf-8">
<title>{{ p.full_name }} - CV</title>
<style>
  @page { size: A4; margin: 13mm 15mm 12mm; }
  * { box-sizing: border-box; }
  body { font-family: "Times New Roman", "Liberation Serif", Times, serif; font-size: 10pt;
         line-height: 1.25; color: #111; margin: 0; text-align: justify; }
  a { color: inherit; text-decoration: none; }
  h1 { font-size: 24pt; margin: 0; line-height: 1.1; }
  .headline { font-size: 12pt; margin-top: 1pt; }
  .contact { margin-top: 3pt; font-size: 9pt; }
  .contact span + span::before { content: " | "; }
  h2 { font-size: 11pt; text-transform: uppercase; margin: 9pt 0 4pt; padding-bottom: 1pt;
       border-bottom: 1.2pt solid #1f2f5a; }
  .item { margin-bottom: 4pt; page-break-inside: avoid; }
  .item > div { text-align: left; }
  .date, .tech { font-style: italic; }
  ul { margin: 1pt 0 0; padding-left: 12pt; }
  li { margin-bottom: 1pt; }
  p { margin: 0; }
  .skill-line { margin-bottom: 1pt; }
</style>
</head>
<body>
  <h1>{{ p.full_name | upper_tr }}</h1>
  {% if cv.headline %}<div class="headline">{{ cv.headline }}</div>{% endif %}
  <div class="contact">
    {% if p.location %}<span>{{ p.location }}</span>{% endif %}
    {% if p.phone %}<span>{{ p.phone }}</span>{% endif %}
    {% if p.email %}<span><a href="mailto:{{ p.email }}">{{ p.email }}</a></span>{% endif %}
    {% for link in p.links %}<span><a href="{{ link.url | link_href }}">{{ link.url | display_url }}</a></span>{% endfor %}
  </div>

  {% if cv.summary %}
  <h2>{{ t.summary }}</h2>
  <p>{{ cv.summary }}</p>
  {% endif %}

  {% if education %}
  <h2>{{ t.education }}</h2>
  {% for ed in education %}
  <div class="item">
    <div>{% if ed.degree or ed.field %}<strong>{{ [ed.degree, ed.field] | select | join(", ") }}</strong> - {% endif %}{{ ed.school }}</div>
    <div class="date">{{ ed.dates }}{% if ed.gpa %} | {{ t.gpa }}: {{ ed.gpa }}{% endif %}</div>
  </div>
  {% endfor %}
  {% endif %}

  {% if skill_groups %}
  <h2>{{ t.skills }}</h2>
  {% for label, names in skill_groups %}
  <div class="skill-line"><strong>{{ label }}:</strong> {{ names | join(", ") }}</div>
  {% endfor %}
  {% endif %}

  {% if experience %}
  <h2>{{ t.experience }}</h2>
  {% for e in experience %}
  <div class="item">
    <div><strong>{{ e.title }}</strong> - {{ e.company }}{% if e.location %}, {{ e.location }}{% endif %}</div>
    <div class="date">{{ e.dates }}</div>
    <ul>{% for b in e.bullets %}<li>{{ b }}</li>{% endfor %}</ul>
  </div>
  {% endfor %}
  {% endif %}

  {% if projects %}
  <h2>{{ t.projects }}</h2>
  {% for pr in projects %}
  <div class="item">
    <div><strong>{{ pr.name }}</strong>{% if pr.tech %} - <span class="tech">{{ pr.tech | join(", ") }}</span>{% endif %}{% if pr.links %} | <a href="{{ pr.links[0].url | link_href }}">{{ pr.links[0].url | display_url }}</a>{% endif %}</div>
    <p>{{ pr.bullets | join(" ") }}</p>
  </div>
  {% endfor %}
  {% endif %}

  {% if p.certifications %}
  <h2>{{ t.certifications }}</h2>
  <ul>{% for c in p.certifications %}<li>{{ c.name }}{% if c.issuer %} - {{ c.issuer }}{% endif %}{% if c.date %} ({{ c.date[:4] }}){% endif %}</li>{% endfor %}</ul>
  {% endif %}

  {% if languages %}
  <h2>{{ t.languages }}</h2>
  <p>{{ languages | join(" • ") }}</p>
  {% endif %}
</body>
</html>
